{
  "name": "dashing-game",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "node tests/e2e/check-playable.mjs && node tests/e2e/flow-8-steps.mjs && node tests/e2e/input-desktop.mjs && node tests/e2e/portrait-progress.mjs && node tests/e2e/hud-stats.mjs && node tests/e2e/compare-legacy.mjs",
    "test:visual": "node tests/e2e/fx-acceptance.mjs && node tests/e2e/bloom-ab.mjs && node tests/e2e/fx-fever-readability.mjs && node tests/e2e/filter-center-probe.mjs && node tests/e2e/fx-moments.mjs && node tests/e2e/hold-monster-keyboard.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "node scripts/verify-single-file.mjs",
    "trace": "node scripts/trace-gate.mjs",
    "test:smoke": "node tests/e2e/smoke.mjs"
  },
  "dependencies": {
    "motion": "^14.5.0",
    "pixi-filters": "^6.1.5",
    "pixi.js": "^8.22.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.5",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.72.0",
    "vite": "^8.3.4",
    "vite-plugin-singlefile": "^2.3.4",
    "vitest": "^5.0.5"
  }
}
